      "deploymentTarget": "16.4",
      "icon": "./assets/icon.png",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSSupportsLiveActivities": true,
        "NSUserTrackingUsageDescription": "This identifier is only used if you opt into personalized features in the future. The app does not track you across other companies' apps or websites.",
        "UIBackgroundModes": [
          "remote-notification",
          "audio"
        ],
        "UIDesignRequiresCompatibility": false
      },
      "supportsTablet": true,
      "privacyManifests": {
        "NSPrivacyTracking": false,
        "NSPrivacyTrackingDomains": [],
