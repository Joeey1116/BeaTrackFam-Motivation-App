{
  "expo": {
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/icon.png"
      },
      "package": "com.beatrackfaminc.motivation",
      "permissions": [],
      "versionCode": 7,
      "blockedPermissions": [
        "com.google.android.gms.permission.AD_ID"
      ]
    },
    "extra": {
      "eas": {
        "projectId": "00000000-0000-0000-0000-000000000000"
      }
